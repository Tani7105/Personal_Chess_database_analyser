<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Runs the chess analyzer (server.py) in the background from login, at http://localhost:5050.
       Stockfish only starts when you analyze something and stops after 10 idle minutes. -->
  <key>Label</key>
  <string>com.godlike7105.chessdb.server</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/tanishqjadhav/Projects/chess-db/venv/bin/python</string>
    <string>-u</string>
    <string>server.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/tanishqjadhav/Projects/chess-db</string>

  <!-- start at login, and restart it if it ever crashes -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <!-- so it can find stockfish (Homebrew) and pmset -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/tanishqjadhav/Projects/chess-db/data/server.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/tanishqjadhav/Projects/chess-db/data/server.log</string>
</dict>
</plist>
